# ==============================================================================
# SENTINEL-X — ENVIRONMENT CONFIGURATION TEMPLATE
# SIH Problem Statement 26248
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Render / Server)
# ------------------------------------------------------------------------------
PORT=8000
ENVIRONMENT=production
DATABASE_URL=sqlite:///./sentinel_x.db
# If using PostgreSQL on Render:
# DATABASE_URL=postgresql://user:password@hostname:5432/sentinel_x_db

# CORS & Allowed Origins (Comma-separated)
FRONTEND_URL=https://your-sentinel-x.vercel.app
CORS_ORIGINS=https://your-sentinel-x.vercel.app,http://localhost:5173

# AI Evaluation Provider ("mock", "gemini", or "openai")
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# Frontend Configuration (Vercel / Client)
# ------------------------------------------------------------------------------
VITE_API_URL=https://your-backend.onrender.com
VITE_WS_URL=wss://your-backend.onrender.com/ws
